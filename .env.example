# ---------------------------------------------------------------
# Copy to .env (Docker) or .env.local (npm run dev) and fill in.
# Leave DATABASE_URL empty to run frontend-only mock mode,
# which is what the Vercel demo uses.
# ---------------------------------------------------------------

# Postgres connection used by the app and drizzle-kit
DATABASE_URL=postgres://worklog:change-me@localhost:5432/worklog

# Used by docker-compose to create the database
POSTGRES_USER=worklog
POSTGRES_PASSWORD=change-me
POSTGRES_DB=worklog

# Where uploaded invoices and transfer proofs are saved on the server
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=10

# Authentication is not built yet. The upload and file APIs refuse
# every request unless this is true. Only enable it on your laptop.
DEV_ALLOW_NO_AUTH=false
